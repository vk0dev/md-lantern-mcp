{
  "name": "@vk0/md-lantern-mcp",
  "version": "1.1.0",
  "description": "Publish markdown as shareable pages from your AI agent or shell via MCP and the mdl CLI.",
  "mcpName": "io.github.vk0dev/md-lantern-mcp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "md-lantern-mcp": "./dist/server.js",
    "mdl": "./dist/cli.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "npm run build && node scripts/dogfood_smoke.mjs",
    "release-check": "node scripts/release-check.mjs",
    "version-sync": "node scripts/version-sync.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "ai-agent",
    "developer-tools",
    "markdown",
    "publish",
    "share",
    "pastebin",
    "cli"
  ],
  "author": "vk0.dev",
  "license": "MIT",
  "homepage": "https://vk0dev.github.io/md-lantern-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vk0dev/md-lantern-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vk0dev/md-lantern-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
